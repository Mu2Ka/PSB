# Безопасный шаблон настроек. Реальный ключ храните в .env.local рядом с этим файлом.
# .env.local: OPENROUTER_API_KEY=ваш_ключ
# Приоритет: переменные процесса > .env.local > .env (пустые значения пропускаются).
RAG_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_EMB_MODEL=openai/text-embedding-3-small

# Настройки платформы; для локального запуска с OpenRouter они не нужны.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=BAAI/bge-m3
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_URL=

KNOWLEDGE_DIR=knowledge-base
CHROMA_DIR=chroma_db
TOP_K=20
RERANKER_TOP_N=5
TEMPERATURE=0.1
MAX_TOKENS=1800
API_TIMEOUT=60
